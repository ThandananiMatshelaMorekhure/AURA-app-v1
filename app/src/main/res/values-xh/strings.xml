    <string name="what_is_aura">Yintoni i-AURA?</string>
    <string name="woman_illustration">Umfanekiso womntu</string>
    <string name="our_mission">Injongo Yethu</string>
    <string name="mission_description">I-AURA yilungu elithembekileyo lokukuqonda nokulawula ixesha lakho lenyanga. Sikholelwa ukuba wonke umntu ofazwe ufanele ukuba afikelele kulwazi oluchanekileyo, oluthi lwazise izigqibo ezinolwazi ngomzimba wakhe nempilo yakhe.</string>
    <string name="what_we_offer">Osi Nikayo</string>
    <string name="feature_1">Ukuqikelela kwexesha lenkqubo nokulandela ukuba khona kwesisu</string>
    <string name="feature_2">Ukulandela iimpawu zemeko yengqondo, amandla, nempilo yomzimba</string>
    <string name="feature_3">Iincwadi zemfundo ngezempilo yabafazi nempilo yokuzala</string>
    <string name="feature_4">Ugciniso lwedatha olugxile kubucala neengcamango ezicwangcisiweyo</string>
    <string name="your_privacy_matters">Ubucala Bakho Bubalulekile</string>
    <string name="privacy_description">Sithatha ubucala bakho ngokuginisekileyo. Idatha yakho yezempilo iyafihlwa kwaye ayisoloko yabelwana ngabathathu. Ugcina ulawulo olupheleleyo ngolwazi lwakho ngaso sonke isihlandlo.</string>
    <string name="join_our_community">Joyina Uluntu Lwethu</string>
    <string name="community_description">Joyina abawaka abafazi abathembela ku-AURA ukuba ibancede baziqonde imizimba yabo kangcono. Kunye, senza indawo exhasayo yokuqwashisa ngezempilo zabafazi nokomeleza.</string>
